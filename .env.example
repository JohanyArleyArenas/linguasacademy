# Base de datos PostgreSQL.
# En desarrollo, una instancia local; en producción, la cadena de conexión que
# te dé tu proveedor (Neon, Supabase, Vercel Postgres, Railway...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linguasacademy?schema=public"

# Clave para firmar las sesiones. Genera una con: openssl rand -base64 32
# Obligatoria en producción. No la compartas ni la subas al repositorio.
AUTH_SECRET="replace-with-a-long-random-string"

# URL pública de la aplicación.
#
# En Vercel: NO la definas. Vercel se detecta solo y así los despliegues de
# vista previa siguen funcionando con su propia URL.
#
# En cualquier otro hosting (Railway, Render, un VPS...): es OBLIGATORIA y
# debe llamarse AUTH_URL, no NEXTAUTH_URL. Auth.js decide si confía en el host
# mirando AUTH_URL; con NEXTAUTH_URL a secas, el login falla en producción con
# el error UntrustedHost.
AUTH_URL="http://localhost:3000"
